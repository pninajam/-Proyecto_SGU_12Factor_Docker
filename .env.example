# Entorno lógico de ejecución; no contiene credenciales reales.
APP_ENV=development
# Puerto interno donde escucha la API.
PORT=8080
# Host de PostgreSQL: dentro de Compose se usa el nombre del servicio.
DB_HOST=db
# Puerto interno estándar de PostgreSQL.
DB_PORT=5432
# Nombre de la base de datos de laboratorio.
DB_DATABASE=sgu
# Usuario de laboratorio; cambiar en entornos reales.
DB_USERNAME=sgu_app
# Contraseña de ejemplo: reemplazar localmente y nunca usar en producción.
DB_PASSWORD=change_me_local_only
# Tiempo máximo de espera al conectar con PostgreSQL, en milisegundos.
DB_CONNECT_TIMEOUT_MS=3000

# Credenciales locales de pgAdmin (cambiar antes de iniciar)
PGADMIN_DEFAULT_EMAIL=admin@sgu.local
PGADMIN_DEFAULT_PASSWORD=Cambiar_PgAdmin_2026!
